MOLINFO MOLTYPE=protein STRUCTURE=step5_input3.pdb

SASA_HASEL TYPE=TOTAL ATOMS=6676-6715,6717-6808,5759-5799,5811-5853,5944-5962,6015-6033, NL_STRIDE=10 LABEL=sasa

METAD ...
    ARG=sasa 
    SIGMA=1.0 
    HEIGHT=0.72     
    PACE=500      
    BIASFACTOR=25  
    FILE=HILLS  
     ... METAD

bias: BIASVALUE ARG=sasa

PRINT ARG=sasa,bias.* STRIDE=500 FILE=COLVAR
