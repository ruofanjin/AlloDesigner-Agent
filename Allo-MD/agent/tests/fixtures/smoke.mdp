; Zero-step single-point fixture for GROMACS -> PLUMED -> SASA_HASEL.
; Coupling and constraints are disabled so this tests integration only and
; never advances the unminimized deployment coordinates.
integrator              = md
dt                      = 0.001
nsteps                  = 0
nstxout-compressed      = 0
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 1
nstenergy               = 1
nstlog                  = 1
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 0.9
vdwtype                 = Cut-off
vdw-modifier            = None
DispCorr                = EnerPres
rvdw                    = 0.9
coulombtype             = PME
rcoulomb                = 0.9
tcoupl                  = no
pcoupl                  = no
constraints             = none
continuation            = yes
nstcomm                 = 0
