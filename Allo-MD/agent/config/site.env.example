# Copy this file outside the immutable bundle, edit it, then pass it with
# `agentctl --site-config /path/to/site.env ...`.

# Optional environment script created by the GROMACS stack installer.
GMX_ENV_SCRIPT=""

# Real executable names. Do not use the interactive `gmx` alias.
GMX_BIN="gmx_mpi"
PLUMED_BIN="plumed"
MDPOCKET_BIN="mdpocket"
# Exact value emitted by install/install_fpocket.sh must replace UNRESOLVED:
# Discngine/fpocket tag 4.2.3 commit 4bb0d8447f62fee77e2c3c29f54b5fcaf5e2c066 bundle-patch-sha256 6ed7a0e8280f10ae0d42c42d771b4a3083e7891d007898bc19f7148bb433481d
MDPOCKET_PROVENANCE="UNRESOLVED"
PYTHON_BIN="python3"

# direct: invoke gmx_mpi directly; mpirun: mpirun -np N; srun: Slurm srun.
GMX_LAUNCHER="direct"
MPIEXEC_BIN="mpirun"
MPI_RANKS="1"
OMP_THREADS="8"

# Packaged production MD profiles require CUDA. The bundle does not install the
# NVIDIA driver/toolkit; install and validate them at the target site first.
GMX_DEVICE_MODE="gpu"
# 为防止改变冻结时长，当前仅允许空值或 -v；禁止 -nsteps/-maxh。
GMX_MDRUN_EXTRA_ARGS="-v"
# 可选：让每次 mdrun 在该小时数前优雅写 checkpoint；计划 nsteps 不变。
GMX_MDRUN_MAXH=""

# Recommended default and the setting in the original CHARMM-GUI README:
# keep step5_input.gro as the restraint reference throughout equilibration.
# historical_previous reproduces the archived executed TPRs and the later
# command notebook, which changed -r to every preceding GRO. Either choice is
# frozen in run provenance.
RESTRAINT_REFERENCE_MODE="charmm_gui_initial"

# Required only for the frozen SASA simulation profiles. The archived DAT files add
# both METAD and BIASVALUE ARG=sasa; this is an extra direct bias potential.
ACK_SASA_BIASVALUE="no"

# Required for run-data commands unless CLI --work-root is supplied.
# It must be outside the read-only deployment bundle.
AGENT_WORK_ROOT=""

# `install/install_fpocket.sh` emits exact values for MDPOCKET_BIN and
# MDPOCKET_PROVENANCE. Install/validate fpocket before preparing a full run.
